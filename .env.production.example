APP_NAME="Moadian Yar"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://example.com
APP_TIMEZONE=Asia/Tehran

APP_LOCALE=fa
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fa_IR
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=moadian
DB_USERNAME=moadian
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

MOADIAN_DRIVER=real
MOADIAN_BASE_URL=https://tp.tax.gov.ir/req/api/self-tsp
MOADIAN_FISCAL_ID=
MOADIAN_SELLER_ECONOMIC_CODE=
MOADIAN_SELLER_BRANCH_CODE=
MOADIAN_PRIVATE_KEY_PATH=/var/www/moadian/shared/keys/private.pem
MOADIAN_CA_BUNDLE_PATH=
MOADIAN_DEFAULT_MEASUREMENT_UNIT_CODE=
MOADIAN_CONNECT_TIMEOUT=5
MOADIAN_TIMEOUT=20
